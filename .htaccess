<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Prevent directory browsing
    Options -Indexes

    # Block direct access to internal PHP/code directories
    RewriteRule ^(app|core|modules|storage|config|lang|install)/.*$ - [F,L]

    # Block direct access to PHP templates inside themes/ (assets are allowed)
    RewriteRule ^themes/.*\.php$ - [F,L]

    # Block access to hidden files and sensitive extensions
    RedirectMatch 404 /\.git
    RedirectMatch 404 /\..*
    RedirectMatch 404 \.(md|sql|yaml|yml|log|lock|env|ini|sh|bak)$

    # Allow direct access to theme ASSET files (JS, CSS, images, fonts)
    # These exist on the filesystem, so mod_rewrite will skip them
    # (RewriteCond %{REQUEST_FILENAME} -f catches them before any rewrite)

    # Route all other requests to the public/ front controller
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.*)$ public/index.php [L,QSA]
</IfModule>
