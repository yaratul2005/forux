<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Prevent directory browsing
    Options -Indexes

    # Block direct access to internal php/code directories
    RewriteRule ^(app|core|modules|storage|config|lang)/.*$ - [F,L]

    # Block direct access to PHP templates in themes/ (but allow assets)
    RewriteRule ^themes/.*\.php$ - [F,L]

    # Block direct access to sensitive file patterns
    RedirectMatch 404 /\.git
    RedirectMatch 404 /\..*
    RedirectMatch 404 \.(md|sql|json|yaml|yml|log|lock|env|ini|sh|bak)$

    # Send requests to the public/ directory transparently if they don't match a real file/folder
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
